SET arr, split(",", input)
SET first, element_at(arr, 0)
SET trimmed, trim(first)
SET len, length(trimmed)
SET lenstr, to_string(len)
SET has_digit, can_parse(lenstr)
SET idx, index_of(input, ",")
SET sliced, slice(input, 0, idx)
SET arr2, remove_at(arr, 0)
SET joined, join("-", arr2)
